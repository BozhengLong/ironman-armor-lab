# 依赖：由 package-lock.json 锁定，不入库
node_modules/

# 系统与工具产物
.DS_Store
__pycache__/
*.py[cod]
*.log
.playwright-mcp/

# 本地调试产物
/tmp/

# 下载缓存：不是源码，而是 scripts/fetch_models.py 从 Sketchfab 拉取的产物。
# 给缓存做版本控制在原理上就是错的 —— 用 assets/assets.lock.json 锁定校验和，
# 靠 `python3 scripts/fetch_models.py` 重建。
assets/raw/
assets/dist/

# 站点构建产物
site/
